class app {
  public:
      int cursor_x = 0;
      int cursor_y = 0;
      int index = 0;
      String text;

      app(int index)
          : index(index) {}

      void cursor(int x,int y,int interior_size,int exterior_size){
        display.drawRect(x, y, exterior_size, exterior_size, SSD1306_WHITE);
        //display.drawRect((exterior_size-interior_size)/2 +x, (exterior_size-interior_size)/2+y, interior_size, interior_size, SSD1306_BLACK);
      }
      int norm_pos(int width) {
        return cursor_y * width + cursor_x;
      }
      virtual void up(bool up){
        if (up == true){
          Serial.print("up");
        }
      }
      virtual void down(bool down){
        if (down == true){
          Serial.print("down");
        }
      }
      virtual void left(bool left){
        if (left == true){
          Serial.print("left");
        }
      }
      virtual void right(bool right){
        if (right == true){
          Serial.print("right");
        }
      }
      virtual void one(bool one){
        if (one == true){
          Serial.print("one");
        }
      }
      virtual void two(bool two){
        if (two == true){
          Serial.print("two");
        }
      }

      virtual void updateApp(){}
};

class menu: public app {
  public:
      menu(int index): app(index)   // Call parent constructor
      {
          cursor_x = 0;
          cursor_y = 0;
      }
    
    void up(bool up){
      if (up == 0) {
        if (cursor_y > 0) cursor_y--;
      }
    }
    void down(bool down){
      if (down == 0) {
          if (cursor_y < 1) cursor_y++;   // only 2 rows
      }
    }
    void left(bool left){
      if (left == 0) {
          if (cursor_x > 0) cursor_x--;
      }
    }
    void right(bool right){
      if (right == 0) {
          if (cursor_x < 3) cursor_x++;
      }
    }
    void one(bool button_one){
      if (button_one == 0) {
          // Wait for release to debounce
          delay(10);
          while (digitalRead(15) == 0) delay(10);
          running_app = norm_pos(4)+1;
        }
    }
    void updateApp() override {
      display.clearDisplay();
      display.drawBitmap(0, 0, menu_1, 128, 64, SSD1306_WHITE);
      cursor(cursor_x * 32, cursor_y * 32, 30, 32);
      display.display();
    }
};

class text_app : public app {
  private:
      String lowlist = "abcdefghijklmnopqrstuvwxyz ";
      String uplist = "ABCDEFGHIJKLMNOPQRSTUVWXYZ ";
      String list;   // start empty, we will set it in constructor

  public:
      String output_text;

      text_app(int index): app(index)   // Call parent constructor
      {
          cursor_x = 0;
          cursor_y = 0;
          output_text = "";
          list = lowlist;
      }
    void screen1(String text,String text2){
      for (int i = 0; i < text.length(); i++) {
        char c = text[i];
        display.setCursor(((i%16)*8)+1, ((i/16)*8)+1);
        display.print(c);
      }
      display.setCursor(0, 56);
      display.print(text2);
      display.setCursor(0, 16);
      display.print("ESCAPE");
    }
    void up(bool up){
      if (up == 0) {
        if (cursor_y > 0) cursor_y--;
      }
    }
    void down(bool down){
      if (down == 0) {
          if (cursor_y < 2) cursor_y++;   // only 3 rows
      }
    }
    void left(bool left){
      if (left == 0) {
          if (cursor_x > 0) cursor_x--;
      }
    }
    void right(bool right){
      if (right == 0) {
          if (cursor_x < 15) cursor_x++;
      }
    }
    void one(bool button_one){
      if (button_one == 0) {
          // Wait for release to debounce
          delay(10);
          while (digitalRead(15) == 0) delay(10);

          if (norm_pos(16) == 27) {
            // Toggle shift once
            list = (list == lowlist) ? uplist : lowlist;
          }
          else if (norm_pos(16) == 28) {
            // Backspace
            if (output_text.length() > 0) output_text.remove(output_text.length() - 1);
          }
          else if (norm_pos(16) <= 26) {
            // Normal character
            output_text += list[norm_pos(16)];
          }
          else if (norm_pos(16) > 31 & norm_pos(16)<37) {
            running_app = 0;
          }
        }
    }
    void two(bool button_two){
      if (button_two == 0){
        Serial.println(output_text);
        serialBT.println(output_text);
        output_text = "";
      }  
    }
    void updateApp() override{
      display.setTextSize(1);
      display.setTextColor(SSD1306_WHITE);
      display.clearDisplay();       // clear every frame

      // draw cursor
      cursor(cursor_x*8, cursor_y*8, 6, 8);

      // draw keyboard row
      if (list == lowlist){
          screen1("abcdefghijklmnopqrstuvwxyz_^<", output_text);
      } else {
          screen1("ABCDEFGHIJKLMNOPQRSTUVWXYZ_^<", output_text);
      }
      display.display();  // actually show the frame
    }

};

menu mainMenu(0);
text_app textapp(1);

const int ammount_of_apps = 1;
std::array<app*, 2> applist = {&mainMenu,&textapp} ;

void setup() {
  textapp.index = 0;
  serialBT.begin("ESP32_phone");
  pinMode(up, INPUT_PULLUP);
  pinMode(down, INPUT_PULLUP);
  pinMode(left, INPUT_PULLUP);
  pinMode(right, INPUT_PULLUP);
  pinMode(one, INPUT_PULLUP);
  pinMode(two, INPUT_PULLUP);
  // put your setup code here, to run once:
  Serial.begin(115200);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.setTextSize(1);
  display.setCursor(1, 1);
  display.setTextWrap(true); 
  textapp.output_text = "";
}

void loop() {
  // Read buttons
  int up_val    = digitalRead(up);
  int down_val  = digitalRead(down);
  int left_val  = digitalRead(left);
  int right_val = digitalRead(right);
  int one_val   = digitalRead(one);
  int two_val   = digitalRead(two);

  // Update app
  applist[running_app]->up(up_val);
  applist[running_app]->down(down_val);
  applist[running_app]->left(left_val);
  applist[running_app]->right(right_val);
  applist[running_app]->one(one_val);
  applist[running_app]->two(two_val);

  applist[running_app]->updateApp();  // draws and displays everything

  delay(50);
}